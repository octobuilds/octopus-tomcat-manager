generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String
}

model Client {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?
  machineId String
  createdAt DateTime  @default(now())
  licenses  License[]
}

model License {
  id                   Int      @id @default(autoincrement())
  clientId             Int
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  licenseKey           String   // The JWT string
  maxUsers             Int
  maxServers           Int
  maxApps              Int
  maxAlarms            Int      @default(10)
  notificationsEnabled Boolean  @default(true)
  expireDays           Int
  createdAt            DateTime @default(now())
}
